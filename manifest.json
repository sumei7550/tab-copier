{
  "manifest_version": 3,
  "name": "Tab Copier - Copy All Tabs Title & Link",
  "version": "1.0.0",
  "description": "Copy all open tabs titles and URLs with one click. Markdown format. Lightweight and privacy-focused.",
  "permissions": ["tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
