# All secrets below are server-only. Never prefix secrets with NEXT_PUBLIC_.
PAYPAL_ENV=sandbox
APP_URL=http://localhost:3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate 32 random bytes encoded as hex; keep stable for session retries.
TOKEN_DERIVATION_SECRET=
# PEM private key, escaped newlines supported. Generate an Ed25519 keypair.
ENTITLEMENT_PRIVATE_KEY=
ENTITLEMENT_KEY_ID=sandbox-v1
# Optional trusted extension origins, comma separated. Not a substitute for bearer auth.
EXTENSION_ORIGINS=
